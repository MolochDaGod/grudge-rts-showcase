# ============================================
# Grudge Studio Client — Environment Variables
# Copy to .env.local and fill in values
# All VITE_ vars are exposed to the browser at build time.
# ============================================

# Auth gateway (handles login, register, Discord OAuth)
VITE_AUTH_GATEWAY_URL=https://grudge-builder-auth.vercel.app
VITE_API_BASE_URL=https://grudge-builder-auth.vercel.app/api

# This app's public URL (used for OAuth return redirects)
VITE_APP_URL=https://grudgestudio.com

# Discord OAuth redirect (handled by auth-gateway, not this app)
VITE_DISCORD_REDIRECT_URI=https://grudge-builder-auth.vercel.app/api/discord
