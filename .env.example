# ============================================
# Grudge Studio Client — Environment Variables
# Copy to .env.local and fill in values
# All VITE_ vars are exposed to the browser at build time.
# ============================================

# Identity API (handles login, register, Discord OAuth)
# Production: https://id.grudge-studio.com (Railway grudge-api)
VITE_AUTH_GATEWAY_URL=https://id.grudge-studio.com
VITE_API_BASE_URL=https://id.grudge-studio.com/api

# This app's public URL (used for OAuth return redirects)
VITE_APP_URL=https://grudgestudio.com

# Discord OAuth redirect (handled by identity API)
VITE_DISCORD_REDIRECT_URI=https://id.grudge-studio.com/api/discord
